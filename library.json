        "base": "examples/link_stats",
        "files": ["link_stats.ino"]
      },
      {
        "name": "rc_channels",
        "base": "examples/rc_channels",
        "files": ["rc_channels.ino"]
      },
      {
        "name": "telemetry",
        "base": "examples/telemetry",
        "files": ["telemetry.ino"]
      }
    ]
  }
